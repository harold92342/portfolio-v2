# Required: Groq API key from https://console.groq.com (server-side only)
GROQ_API_KEY=

# Optional: Groq chat model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Required: Long passphrase for /admin sign-in
ADMIN_PASSWORD=

# Required: 32+ random characters used to sign admin JWT cookies (HS256)
JWT_SECRET=

# Required (injected automatically by Vercel Storage -> Neon Postgres)
DATABASE_URL=

# Required for uploads (injected automatically by Vercel Storage -> Blob)
BLOB_READ_WRITE_TOKEN=
