{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{content,templates}/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' https: data: blob:; connect-src 'self' https://blob.vercel-storage.com https://*.blob.vercel-storage.com https://vercel.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "^/admin(/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/assets/fonts/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(lib|content|templates)(/.*)?$",
      "status": 404,
      "dest": "/__not_found__"
    },
    {
      "src": "^/(PRD-portfolio-chatbot\\.md|tasks\\.md|package(-lock)?\\.json|vercel\\.json|README\\.md|\\.env\\.example)$",
      "status": 404,
      "dest": "/__not_found__"
    },
    {
      "src": "^/$",
      "dest": "/api/page?lang=en"
    },
    {
      "src": "^/fr/?$",
      "dest": "/api/page?lang=fr"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
